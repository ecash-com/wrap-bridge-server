# This file terminates the public name on the same machine as the app. That publishes the
# machine's address. For a host whose location must stay hidden, do not use this file.
# Use deploy/edge/ instead: Cloudflare sees only an expendable relay.
swap.beta.ecash.com {
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	reverse_proxy 127.0.0.1:3001
}