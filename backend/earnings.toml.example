# Cold-storage sweep settings. On an installed bridge this file is generated by install.sh at
# /etc/ecash-bridge/earnings.toml from OWNER_ECX_ADDRESS, OWNER_SOL_ADDRESS, and the two
# EARNINGS_THRESHOLD lines in params.conf. Do not edit the generated file by hand; change
# params.conf and run the installer again.
#
# For a local development run, copy this to backend/earnings.toml (gitignored), put in addresses
# you control, and set enabled = true. Both addresses below are samples. The server refuses to
# start with enabled = true if the Solana address is not a wallet address or the ECX address
# belongs to the hot wallet.
enabled = false
# Whole coins, up to 8 decimal places. Fees above a threshold are swept to the matching address.
earnings_threshold_wbecx = "100"
earnings_threshold_becx = "100"
# A Solana wallet address you control, not the treasury and not a token account.
solana_owner_address = "BgPMuJ6FqLNbtNgHAk6hQBW7Nj9Q1U8udJ7ZzL3iVM7j"
# A bc1q address you control, on a different seed from the hot wallet.
ecx_owner_address = "bc1q4jkcq5jllzmjypjx8vwy0n42vxzl0w4l5zn4tu"
