# --- Required secrets ---
# Both fields are left empty on purpose. Generate new keys and keep them only in the untracked
# .env. The server refuses the public example phrases and the secrets that were once committed to
# an older repository; anyone who used those should treat that hot wallet as compromised.

# ECX treasury: BIP39 mnemonic dedicated to this service (don't reuse one that controls funds elsewhere).
WALLET_MNEMONIC=""
# Solana treasury: base58-encoded 64-byte secret key (`cargo run -- solana-keygen` prints one).
# Separate from WALLET_MNEMONIC - different curve (ed25519 vs secp256k1), kept separate to
# limit blast radius if one key leaks.
SOLANA_KEYPAIR=""

# --- Other required envs ---
WECX_MINT_ADDRESS="EVHqNdzjCupKi4rQkbuYw52sa1m8A7jeUAMP23S9AVVq"
# Display name of the one asset this bridge wraps. The wrapped name is always "w" plus this.
# Missing or invalid falls back to bECX, shown as bECX and wbECX.
ASSET_TICKER="bECX"

# URLs
ECX_ESPLORA_URL="https://explorer.beta.ecash.ninja/api/"
# Local runs with payouts off may use the public endpoint. Live payouts refuse it. An installed
# bridge gets a paid URL from params.conf. See deploy/edge/solana-rpc.md.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# Block explorer pages the order page links transaction ids to; the id is appended after a slash.
# The ECX one defaults to the site that hosts ECX_ESPLORA_URL (…/api -> …/tx). Set either to an
# empty string to show bare ids instead of links.
# ECX_EXPLORER_TX_URL="https://explorer.beta.ecash.ninja/tx"
# SOLANA_EXPLORER_TX_URL="https://solscan.io/tx"






# --- Optional (everything below is commented out; defaults shown) ---
# SQLite database file (created if missing).
# DATABASE_PATH="data/bridge.db"
# WALLET_PASSPHRASE=""
# ECX_BACKEND="esplora"
# ESPLORA_TIMEOUT_SECS="20"

# ORDER_POLL_INTERVAL_MINUTES="5"
# Minutes a new order waits for its deposit before it expires. Checked on poll ticks, so the
# effective window is this plus up to one poll interval. A deposit that lands after expiry still
# revives the order for ORDER_EXPIRY_GRACE_HOURS (default 168), both from the poller and when the
# customer opens the order page. The old name ORDER_MAX_AGE_HOURS is still read if this is absent.
# ORDER_LIFETIME_MINUTES="15"

# MIN_DEPOSIT_AMOUNT_SAT="500"
# Confirmations required before an ECX deposit is paid out. Default 3. Do not set this to 0.
# ECX_DEPOSIT_MIN_CONFS="3"
# ECX_PAYOUT_FEE_RATE_SAT_VB="3"

# Percentage fee (100 = 1%) on each bridge direction: PEGIN_FEE_BPS for ECX->wECX,
# PEGOUT_FEE_BPS for wECX->ECX.
# PEGIN_FEE_BPS="100"
# PEGOUT_FEE_BPS="100"
# Restocking fee, in basis points. A wrap or unwrap that cannot be bridged, and a wECX transfer
# that reaches the treasury with no order's reference key, is sent back to the address it came
# from minus this fee. The customer is told the deposit was formatted wrong. An unmatched transfer
# is sent once finalized, when the sender is an ordinary wallet and ALLOW_LIVE_PAYOUTS is on.
# UNMATCHED_DEPOSIT_REFUNDS=0 holds unmatched transfers for manual review instead
# (`unmatched-deposits` lists them); it does not stop order refunds. Deposits from the earnings
# owner address or TREASURY_FUNDING_ADDRESSES (comma separated) are treasury funding and are kept.
# UNMATCHED_DEPOSIT_REFUNDS="1"
# UNMATCHED_DEPOSIT_FEE_BPS="100"
# TREASURY_FUNDING_ADDRESSES=""
# Extra fixed amount kept on every ECX deposit, on top of the percentage and the minimum order.
# 1000 sat = 0.00001000 ECX. It covers spending the deposit output, including a dust output the
# sender may attach. It is removed before the percentage. A deposit must still meet
# MIN_DEPOSIT_AMOUNT_SAT, and must leave a nonzero payout after this deduction.
# PEGIN_FLAT_FEE_SAT="1000"
# Optional wrap checkbox. 5000000 lamports = 0.005 SOL, paid for with 500000 sat (0.005 of the
# native asset). Set both amounts to 0 to hide it. The dollar label is display-only.
# SOL_STIPEND_LAMPORTS="5000000"
# SOL_STIPEND_PRICE_SAT="500000"
# SOL_STIPEND_USD_LABEL="0.50"

# Both betanet ECX and Solana mainnet-beta are real money. This gates every automatic
# outbound send in both directions (wECX payouts, ECX refunds, ECX payouts, wECX refunds) the
# background poller makes. Set to 1 only once you've verified the bridge end to end.
# ALLOW_LIVE_PAYOUTS=0

# --- Abuse limits / safety floors (all optional; defaults shown) ---
# Largest single order, in sat (default: 21M ECX, i.e. effectively unbounded - lower it to cap exposure).
# MAX_DEPOSIT_AMOUNT_SAT="2100000000000000"
# Global burst backstop, both directions combined: default 120 per rolling minute (about two per
# second), 0 disables it. Sized so a full-rate burst stays within the public Solana RPC's allowance;
# real traffic should never reach it. Per-client limits live in front of the backend: the frontend
# allows 8 order requests per minute per client address, and a Cloudflare rate limiting rule
# (deploy/edge/cloudflare.md) refuses floods before they reach the tunnel.
# ORDERS_PER_MINUTE="120"
# Open orders per direction. This is the sustained flood cap and the bound on one poll tick's work:
# each pending wrap is one Esplora lookup (in chunks of 50 that release the wallet lock), each
# pending unwrap one Solana RPC call. Once it is full, new orders wait until one expires
# (ORDER_LIFETIME_MINUTES) or is settled. Raise it with your own Esplora and RPC. There is no
# separate daily quota, because spending a shared daily budget would lock out every customer.
# MAX_PENDING_ORDERS="500"
# Min spacing between explorer syncs triggered by GET /orders/{id} (each holds the wallet lock).
# GET_SYNC_MIN_INTERVAL_SECS="10"
# Below this treasury SOL balance (lamports; 0.02 SOL) new orders are refused and payouts held.
# Each payout to a new recipient spends ~0.002 SOL of ATA rent, so keep the treasury topped up and
# set MIN_DEPOSIT_AMOUNT_SAT high enough that a minimum deposit is worth that rent to you.
# TREASURY_MIN_SOL_LAMPORTS="20000000"
# Off-curve (PDA) Solana recipients, e.g. some multisig vaults, are refused unless this is 1.
# ALLOW_OFF_CURVE_RECIPIENTS="0"
